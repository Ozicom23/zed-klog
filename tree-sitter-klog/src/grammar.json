{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "klog",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "record"
          },
          {
            "type": "SYMBOL",
            "name": "_record_separator"
          }
        ]
      }
    },
    "record": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "date",
          "content": {
            "type": "SYMBOL",
            "name": "date"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "should_total",
              "content": {
                "type": "SYMBOL",
                "name": "should_total"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_line_break"
                },
                {
                  "type": "FIELD",
                  "name": "summary",
                  "content": {
                    "type": "SYMBOL",
                    "name": "record_summary"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_entry_break"
              },
              {
                "type": "FIELD",
                "name": "entry",
                "content": {
                  "type": "SYMBOL",
                  "name": "entry"
                }
              }
            ]
          }
        }
      ]
    },
    "date": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "\\d{4}-\\d{2}-\\d{2}"
          },
          {
            "type": "PATTERN",
            "value": "\\d{4}\\/\\d{2}\\/\\d{2}"
          }
        ]
      }
    },
    "should_total": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "duration",
          "content": {
            "type": "SYMBOL",
            "name": "duration"
          }
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "!"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "record_summary": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_summary_line"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_line_break"
              },
              {
                "type": "SYMBOL",
                "name": "_summary_line"
              }
            ]
          }
        }
      ]
    },
    "entry": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "duration"
              },
              {
                "type": "SYMBOL",
                "name": "range"
              },
              {
                "type": "SYMBOL",
                "name": "open_range"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "summary",
              "content": {
                "type": "SYMBOL",
                "name": "entry_summary"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "entry_summary": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_summary_line"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_continuation_break"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "_summary_line"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_continuation_break"
              },
              {
                "type": "SYMBOL",
                "name": "_summary_line"
              }
            ]
          }
        }
      ]
    },
    "duration": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[+-]"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "\\d+h\\d+m"
              },
              {
                "type": "PATTERN",
                "value": "\\d+h"
              },
              {
                "type": "PATTERN",
                "value": "\\d+m"
              }
            ]
          }
        ]
      }
    },
    "range": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "start",
          "content": {
            "type": "SYMBOL",
            "name": "time"
          }
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "FIELD",
          "name": "end",
          "content": {
            "type": "SYMBOL",
            "name": "time"
          }
        }
      ]
    },
    "open_range": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "start",
          "content": {
            "type": "SYMBOL",
            "name": "time"
          }
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "FIELD",
          "name": "end",
          "content": {
            "type": "SYMBOL",
            "name": "placeholder"
          }
        }
      ]
    },
    "time": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "<"
            },
            {
              "type": "IMMEDIATE_TOKEN",
              "content": {
                "type": "PATTERN",
                "value": "\\d{1,2}:\\d{2}(am|pm)?"
              }
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "PATTERN",
              "value": "\\d{1,2}:\\d{2}(am|pm)?"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "IMMEDIATE_TOKEN",
                  "content": {
                    "type": "STRING",
                    "value": ">"
                  }
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          ]
        }
      ]
    },
    "placeholder": {
      "type": "PATTERN",
      "value": "\\?+"
    },
    "_summary_line": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_text"
          },
          {
            "type": "SYMBOL",
            "name": "tag"
          },
          {
            "type": "STRING",
            "value": "#"
          }
        ]
      }
    },
    "_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^# \\t\\r\\n][^#\\r\\n]*"
        }
      }
    },
    "tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "tag_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "IMMEDIATE_TOKEN",
                  "content": {
                    "type": "PREC",
                    "value": 1,
                    "content": {
                      "type": "STRING",
                      "value": "="
                    }
                  }
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "FIELD",
                      "name": "value",
                      "content": {
                        "type": "SYMBOL",
                        "name": "tag_value"
                      }
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "tag_name": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[\\p{L}0-9_-]+"
        }
      }
    },
    "tag_value": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "\"[^\"\\r\\n]*\""
            },
            {
              "type": "PATTERN",
              "value": "'[^'\\r\\n]*'"
            },
            {
              "type": "PATTERN",
              "value": "[\\p{L}0-9_-]+"
            }
          ]
        }
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_line_break"
    },
    {
      "type": "SYMBOL",
      "name": "_entry_break"
    },
    {
      "type": "SYMBOL",
      "name": "_continuation_break"
    },
    {
      "type": "SYMBOL",
      "name": "_record_separator"
    },
    {
      "type": "SYMBOL",
      "name": "_error_sentinel"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}